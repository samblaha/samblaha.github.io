# Local development dependencies for this Jekyll site.
# Run:
#   bundle install
#   bundle exec jekyll serve --livereload
#
# Note: Your current Ruby is 2.6.x; pin Jekyll to a compatible minor.
# Use a 3-part version to avoid floating to 4.3.x with the pessimistic operator.
gem "jekyll", "~> 4.2.0"

# Ruby 3+ no longer ships WEBrick; Jekyll uses it for `serve`.
gem "webrick", "~> 1.8"


