---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} · builds</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>en</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% assign builds = site.projects | sort: "date" | reverse %}
    {% for project in builds limit: 20 %}
    <item>
      <title>{{ project.title | xml_escape }}</title>
      <description>{{ project.summary | default: project.content | strip_html | xml_escape }}</description>
      <pubDate>{{ project.date | date_to_rfc822 }}</pubDate>
      <link>{{ project.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ project.url | absolute_url }}</guid>
      {% for tag in project.tags %}<category>{{ tag | xml_escape }}</category>{% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
